# Writes OUTPUT, a header with one function per SPIR-V file in INPUTS (comma-separated):
#   const std::vector<std::uint32_t>& <name>_spv();   // name: the file name without extension
# Run as: cmake -DINPUTS=... -DOUTPUT=... -P embed_spirv.cmake
set(body "#pragma once\n// Generated by cmake/embed_spirv.cmake from the compiled shaders.\n\n#include <cstdint>\n#include <vector>\n\nnamespace grefim {\n")
string(REPLACE "," ";" INPUTS "${INPUTS}")
foreach(input IN LISTS INPUTS)
    get_filename_component(name ${input} NAME_WE)
    file(READ ${input} hex HEX)
    # SPIR-V is little-endian words: regroup the bytes "aabbccdd" into 0xddccbbaa.
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," words "${hex}")
    string(APPEND body "\ninline const std::vector<std::uint32_t>& ${name}_spv() {\n\tstatic const std::vector<std::uint32_t> code{${words}};\n\treturn code;\n}\n")
endforeach()
string(APPEND body "\n}  // namespace grefim\n")
file(WRITE ${OUTPUT} "${body}")
